# ─────────────────────────────────────────────────────────────
#  Supabase connection — copy this file to .env.local and fill in.
#  Dashboard → Project Settings → API (or "API Keys" / "Data API")
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The PUBLISHABLE key (sb_publishable_...) — safe to expose in the browser
# because Row Level Security protects every table. Either variable name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# ⚠️  Do NOT put the SECRET key (sb_secret_...) here or anywhere with a
#     NEXT_PUBLIC_ prefix. This app never needs it — admin writes are
#     authorized by the logged-in session + database RLS.
